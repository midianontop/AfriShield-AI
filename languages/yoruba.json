  "_metadata": {
    "language": "Yoruba",
    "language_code": "yo",
    "project": "AfriShield AI",
    "purpose": "Maps common Yoruba security/fraud-related terms to their canonical English keyword equivalents, for use in multilingual scam/threat detection.",
    "version": "2.1.0",
    "maintainer": "Midian",
    "disclaimer": "This is a starter, community-style vocabulary, not an exhaustive or professionally certified translation. Confidence levels are noted per entry. Corrections and native-speaker review are welcome, especially for entries marked 'community' or 'uncertain'.",
    "confidence_levels": {
      "verified": "Cross-checked against a published Yoruba-English dictionary/glossary or genuine Yoruba-language source text.",
      "common": "Widely known/standard vocabulary or loanword, high confidence, not individually cross-checked in a dictionary this session.",
      "uncertain": "A compositionally constructed phrase (built from verified words) rather than a confirmed idiom; flagged for native-speaker review."
    },
    "notes": [
      "Yoruba orthography marks three tones (acute á, grave à, and unmarked mid) plus underdots on ẹ, ọ, ṣ. Real-world typed text (SMS, WhatsApp, social media) very often omits all of these. Where a term is likely to be typed in practice, both the fully-marked spelling and a plain-ASCII fallback are included as separate keys mapping to the same English value.",
      "Deliberately did not include single-syllable, highly polysemous words (e.g. 'sí' = to/at/open, 'pa' = close/kill/switch off, 'mu' = arrest/drink/hold) as standalone translation entries — the collision risk with everyday unrelated Yoruba text was judged too high. These are listed in stopwords instead where they are primarily grammatical, or omitted entirely (see notes on 'open'/'close' gap)."
    ],
    "known_gaps": [
      "No high-confidence standalone term found this session for 'open'/'close' (account) or 'verify' as single words without ambiguity risk — omitted rather than guessed."
    ]
  },
  "stopwords": {
    "ti": "Perfect aspect marker ('has/have') and multi-purpose particle ('from', possessive-like constructions). Very high frequency; strip before matching.",
    "ni": "Copula ('is/are') or locative particle ('at/in').",
    "si": "Directional/locative particle ('to/at'), also used as 'and then'.",
    "yi": "'This' (also spelled yii).",
    "yii": "'This' (alternate spelling of yi).",
    "won": "'They/them' — third person plural pronoun.",
    "mo": "'I' — first person singular subject pronoun.",
    "o": "'He/she/it' — third person singular subject marker. Very short/ambiguous; grammatical only.",
    "a": "'We' or impersonal subject marker ('one/it').",
    "ki": "Subjunctive/purpose particle ('so that/that').",
    "pe": "Complementizer ('that', e.g. 'so pe' = 'say that').",
    "ati": "'And'.",
    "sugbon": "'But' (also spelled ṣùgbọ́n)."
  },
