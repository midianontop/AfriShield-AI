    "language": "Igbo",
    "language_code": "ig",
    "project": "AfriShield AI",
    "purpose": "Maps common Igbo security/fraud-related terms to their canonical English keyword equivalents, for use in multilingual scam/threat detection.",
    "version": "2.1.0",
    "maintainer": "Midian",
    "disclaimer": "This is a starter, community-style vocabulary, not an exhaustive or professionally certified translation. Confidence levels are noted per entry. Corrections and native-speaker review are welcome, especially for entries marked 'community' or 'uncertain'.",
    "confidence_levels": {
      "verified": "Cross-checked against a published Igbo-English dictionary/glossary or genuine Igbo-language source text (e.g. a translated digital-security guide).",
      "common": "Widely known/standard vocabulary or loanword, high confidence, not individually cross-checked in a dictionary this session.",
      "uncertain": "A compositionally constructed phrase (built from verified words) rather than a confirmed idiom, or a term carried over from the original source list that could not be confirmed; flagged for native-speaker review."
    },
    "notes": [
      "Igbo marks dot-below vowels (ị, ọ, ụ) and a dot-above ṅ, which are frequently dropped in real typed text (SMS, WhatsApp). Where relevant, both the correctly-marked spelling and a plain-ASCII fallback are included as separate keys mapping to the same English value.",
      "'ojoro' from the original seed list is corrected here: 'ọjọọ'/'ọjọ' is dictionary-confirmed to mean 'bad/evil' generally, not 'fraud' specifically. Kept below marked as uncertain/deprecated, with 'aghụghọ' (dictionary-confirmed: fraud/deceit) provided as the verified replacement.",
      "'hack'/'hacked' as bare loanwords are common code-switching in spoken Nigerian Igbo tech talk; the fuller native compound for 'hacker' (onye ozu ihe dị na kọmputa ndị ọzọ) is also included, confirmed via an independent Igbo-vocabulary source."
    ]
  },
  "stopwords": {
    "e": "Impersonal/general subject prefix (similar to 'one/it').",
    "anyị": "'We' — first person plural pronoun.",
    "m": "'I' / 'my' — first person singular pronoun/possessive suffix.",
    "gị": "'You' / 'your' — second person singular pronoun/possessive suffix, extremely high frequency (e.g. 'paswọọdụ gị' = 'your password').",
    "ọ": "'He/she/it' — third person singular subject marker.",
    "ha": "'They/them' — third person plural pronoun.",
    "ya": "'Him/her/it' — object pronoun.",
    "na": "'And' / 'with' / 'at' — extremely common conjunction/preposition.",
    "ka": "'That' / 'so that' / 'more than' — complementizer or comparative.",
    "bụ": "Copula ('is/to be').",
    "nwere": "'Have/has'.",
    "anyị nwere": "'We have' — compositional phrase, carried over from the original seed list."
